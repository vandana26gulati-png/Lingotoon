# Lingotoon Animation Studio - Google Drive Cloud Configuration
# Set these to enable automatic cloud hosting on your Google Drive (with TBs storage)

# The Web App URL generated from deploying lingotoon-gdrive-bridge.gs in script.google.com
VITE_GDRIVE_API_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# The Google Drive Folder ID where you want images and database saved
VITE_GDRIVE_FOLDER_ID=YOUR_GOOGLE_DRIVE_FOLDER_ID
